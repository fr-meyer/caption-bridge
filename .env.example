MISTRAL_API_KEY=
MISTRAL_TRANSCRIBE_MODEL=voxtral-mini-transcribe-realtime-2602
MISTRAL_TRANSLATE_MODEL=zai-glm-5-3
TARGET_STREAMING_DELAY_MS=1000
AUDIO_SAMPLE_RATE=16000
AUDIO_QUEUE_MAX_CHUNKS=50
PAUSE_TIMEOUT_MS=1500
FRAGMENT_MERGE_ENABLED=true
FRAGMENT_MAX_HOLD_MS=3000
FRAGMENT_MIN_CHARS=15
FRAGMENT_MIN_TOKENS=3
TRANSLATION_CONTEXT_SEGMENTS=5
TRANSLATION_TIMEOUT_MS=10000
TRANSLATION_GLM_TIMEOUT_MS=20000
TRANSLATION_DRAIN_TIMEOUT_MS=30000
TRANSLATION_PROVIDER=mistral
TRANSLATION_MAX_CONCURRENCY=8
TRANSLATION_REPAIR_MAX_ATTEMPTS=1
READINESS_POLL_INTERVAL_MS=3000
CLIENT_DISCONNECT_GRACE_MS=45000
WS_OUTBOUND_QUEUE_MAX=256
RECONNECT_BASE_BACKOFF_MS=1000
RECONNECT_MAX_BACKOFF_MS=15000
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_MAX_ELAPSED_MS=60000
RECONNECT_JITTER_FACTOR=0.25
JOURNAL_DIR=./runs/.journal
RECOVERY_EXPORT_DIR=./runs/recovered
RELIABILITY_DIR=./runs/reliability
TRANSCRIPT_RETENTION_DAYS=30
HOST=127.0.0.1
PORT=8765
EXPORT_DIR=./runs
# MISTRAL_REALTIME_BASE_URL=
DEFAULT_SOURCE_LANGUAGE=auto
DEFAULT_TARGET_LANGUAGE=en
MISTRAL_TTS_VOICE_ID=
MISTRAL_TTS_TRANSIENT_MAX_RETRIES=2
MISTRAL_TTS_RETRY_BASE_DELAY_MS=500
MISTRAL_TTS_RETRY_MAX_DELAY_MS=2000
MISTRAL_TTS_RETRY_JITTER_FACTOR=0.25
